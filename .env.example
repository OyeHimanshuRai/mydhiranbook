APP_NAME=MyDhiranBook
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mydhiranbook.shop

DB_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_COOKIE=dhiran_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
QUEUE_NAME=dhiran-production
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=MyDhiranBook

# Production refuses to boot unless this names the proxy address(es) in front of the app (comma list of IPs/CIDRs;
# 127.0.0.1 for nginx on the same host), or DIRECT_EXPOSURE=true says the app faces the internet with no proxy at all.
# Empty or * is refused in production.
TRUSTED_PROXIES=127.0.0.1
DIRECT_EXPOSURE=false

BUSINESS_NAME=
BUSINESS_LEGAL_NAME=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
BUSINESS_JURISDICTION=India
